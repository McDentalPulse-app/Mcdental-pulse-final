# Jitsi Meet para Pulse. Generado el 2026-07-28.
#
# ACCESO SOLO CON TOKEN: ENABLE_AUTH=1 + AUTH_TYPE=jwt + ENABLE_GUESTS=0.
# Sin esto, el nombre de la sala ES la contraseña: quien reciba la URL entra. Con
# sesiones de psicología dentro, no se sostiene. Pulse firma un JWT por persona y
# por sala en api/reunion-token.js, y prosody solo deja pasar a quien lo trae.
CONFIG=__NO_SE_VERSIONA__
TZ=__NO_SE_VERSIONA__
PUBLIC_URL=__NO_SE_VERSIONA__

# El JVB anuncia esta IP para el medio. La máquina la tiene directa, sin NAT.
JVB_ADVERTISE_IPS=__NO_SE_VERSIONA__

# El web escucha solo en localhost: quien lo publica es el nginx del host, que ya
# tiene el certificado. Exponerlo fuera sería una segunda puerta sin TLS.
HTTP_PORT=__NO_SE_VERSIONA__
HTTPS_PORT=__NO_SE_VERSIONA__

XMPP_DOMAIN=__NO_SE_VERSIONA__
XMPP_AUTH_DOMAIN=__NO_SE_VERSIONA__
XMPP_MUC_DOMAIN=__NO_SE_VERSIONA__
XMPP_INTERNAL_MUC_DOMAIN=__NO_SE_VERSIONA__
XMPP_SERVER=__NO_SE_VERSIONA__
XMPP_BOSH_URL_BASE=__NO_SE_VERSIONA__

JICOFO_AUTH_USER=__NO_SE_VERSIONA__
JVB_AUTH_USER=__NO_SE_VERSIONA__
JICOFO_AUTH_PASSWORD=__NO_SE_VERSIONA__
JVB_AUTH_PASSWORD=__NO_SE_VERSIONA__
JICOFO_COMPONENT_SECRET=__NO_SE_VERSIONA__

ENABLE_AUTH=__NO_SE_VERSIONA__
ENABLE_GUESTS=__NO_SE_VERSIONA__
AUTH_TYPE=__NO_SE_VERSIONA__
JWT_APP_ID=__NO_SE_VERSIONA__
JWT_APP_SECRET=__NO_SE_VERSIONA__
JWT_ACCEPTED_ISSUERS=__NO_SE_VERSIONA__
JWT_ACCEPTED_AUDIENCES=__NO_SE_VERSIONA__

# Nada de grabar ni retransmitir: grabar sesiones de psicología es una decisión
# legal, no técnica, y por defecto no se hace.
ENABLE_RECORDING=__NO_SE_VERSIONA__
ENABLE_LIVESTREAMING=__NO_SE_VERSIONA__
DISABLE_DEEP_LINKING=__NO_SE_VERSIONA__
ENABLE_PREJOIN_PAGE=__NO_SE_VERSIONA__

# TURN (alternativa cuando el UDP directo al JVB no pasa)
TURN_CREDENTIALS=__NO_SE_VERSIONA__
TURN_HOST=__NO_SE_VERSIONA__
TURN_PORT=__NO_SE_VERSIONA__
TURN_TRANSPORT=__NO_SE_VERSIONA__
TURN_TTL=__NO_SE_VERSIONA__
TURNS_HOST=__NO_SE_VERSIONA__
TURNS_PORT=__NO_SE_VERSIONA__
